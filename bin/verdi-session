#!/usr/bin/env python3
"""
verdi-session — launch Verdi with an auto-allocated command port and keep a
per-user registry so agents can discover and attach to the right session.

Usage:
  verdi-session start [--label L] [--port P] [--timeout SEC] [--detach] [--] [verdi args...]
  verdi-session list [--json] [--all]
  verdi-session exec <id|--label L|--port P> [--hold SEC] <cmd> [cmd...]
  verdi-session stop <id|--label L|--port P>
  verdi-session prune
  verdi-session info <id>

Registry: $VERDI_SESSION_DIR (default ~/.local/state/verdi-sessions)
Ports:    11000-11999, never the ephemeral range.
"""

import argparse
import fcntl
import json
import os
import random
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

PORT_MIN = 11000
PORT_MAX = 11999
DEFAULT_TIMEOUT = 180

STATE_DIR = Path(os.environ.get("VERDI_SESSION_DIR", Path.home() / ".local/state/verdi-sessions"))
LOCK_FILE = STATE_DIR / ".lock"
RESERVE_PREFIX = ".port-"

CLIENT_CANDIDATES = [
    os.environ.get("VERDI_CMDCLIENT", ""),
    str(Path(__file__).resolve().parent / "cmdclient"),
    os.path.expanduser("~/.local/libexec/verdi-session/cmdclient"),
]


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def ensure_state():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)


def cmdclient_path():
    for p in CLIENT_CANDIDATES:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    sys.exit("error: cmdclient not found; build it (build.sh) or set VERDI_CMDCLIENT")


def verdi_home():
    home = os.environ.get("VERDI_HOME")
    if not home:
        sys.exit("error: VERDI_HOME is not set (export it, or source your site EDA env)")
    return home


def verdi_bin():
    p = Path(verdi_home()) / "bin" / "verdi"
    if p.is_file():
        return str(p)
    found = shutil.which("verdi")
    if found:
        return found
    sys.exit(f"error: verdi not found under {verdi_home()} nor on PATH")


def build_env():
    env = dict(os.environ)
    env.setdefault("VERDI_HOME", verdi_home())
    lib = str(Path(verdi_home()) / "share/libcmd/linux64")
    env["LD_LIBRARY_PATH"] = lib + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    env["PATH"] = str(Path(verdi_home()) / "bin") + ":" + env.get("PATH", "")
    return env


def port_in_use(port):
    # Any listener on any local address blocks the port.
    r = subprocess.run(["ss", "-ltn"], capture_output=True, text=True)
    if r.returncode == 0 and re.search(rf":{port}\s", r.stdout):
        return True
    # Probe bind on the wildcard address to catch exact-address listeners.
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("0.0.0.0", port))
        return False
    except OSError:
        return True
    finally:
        s.close()


def allocate_port(preferred=None):
    if preferred:
        if port_in_use(preferred):
            sys.exit(f"error: requested port {preferred} is in use")
        return preferred
    ports = list(range(PORT_MIN, PORT_MAX + 1))
    random.shuffle(ports)
    for p in ports:
        reserved = STATE_DIR / f"{RESERVE_PREFIX}{p}"
        try:
            fd = os.open(reserved, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            continue
        os.close(fd)
        if not port_in_use(p):
            return p
        reserved.unlink(missing_ok=True)
    sys.exit(f"error: no free port in {PORT_MIN}-{PORT_MAX}")


def port_listening(port):
    for addr in ("127.0.1.1", "127.0.0.1"):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)
        try:
            if s.connect_ex((addr, port)) == 0:
                return True
        finally:
            s.close()
    return False


def entry_path(sid):
    return STATE_DIR / f"{sid}.json"


def write_entry(entry):
    ensure_state()
    tmp = entry_path(entry["id"]).with_suffix(".tmp")
    tmp.write_text(json.dumps(entry, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(entry_path(entry["id"]))


def read_entries():
    if not STATE_DIR.is_dir():
        return []
    out = []
    for p in sorted(STATE_DIR.glob("*.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, json.JSONDecodeError):
            continue
    return out


def proc_cmdline(pid):
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return raw.replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return ""


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def session_state(entry):
    pid, port = entry.get("pid"), entry.get("port")
    if not pid or not port:
        return "stale"
    if not pid_alive(pid):
        return "stale"
    if f"-serverPort {port}" not in proc_cmdline(pid):
        return "stale"          # PID reuse or wrong process
    if not ss_listen(port):
        return "down"
    return "up"


def resolve(sid=None, by_label=None, by_port=None):
    entries = read_entries()
    if sid:
        entries = [e for e in entries if e.get("id") == sid]
    elif by_label:
        entries = [e for e in entries if e.get("label") == by_label]
    elif by_port:
        entries = [e for e in entries if e.get("port") == by_port]
    if not entries:
        sys.exit("error: no matching session")
    if len(entries) > 1:
        ids = ", ".join(e["id"] for e in entries)
        sys.exit(f"error: ambiguous selector; matches: {ids}")
    return entries[0]


def ss_listen(port):
    r = subprocess.run(["ss", "-ltn"], capture_output=True, text=True)
    return r.returncode == 0 and re.search(rf":{port}\s", r.stdout)



def _arg_values(argv, flag):
    out = []
    for i, a in enumerate(argv):
        if a == flag and i + 1 < len(argv):
            out.append(argv[i + 1])
    return out

def cmd_start(args):
    if not os.environ.get("DISPLAY"):
        sys.exit("error: DISPLAY is not set; Verdi needs an X display")

    ensure_state()
    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        port = allocate_port(args.port)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()

    sid = uuid.uuid4().hex[:8]
    cmd = [verdi_bin(), "-serverPort", str(port)] + args.verdi_args
    env = build_env()

    log = None
    kwargs = {}
    if args.detach:
        log_path = STATE_DIR / f"{sid}.log"
        log = open(log_path, "w")
        kwargs = dict(start_new_session=True, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    else:
        kwargs = dict(start_new_session=False)

    proc = subprocess.Popen(cmd, cwd=os.getcwd(), env=env, **kwargs)

    entry = {
        "id": sid,
        "pid": proc.pid,
        "port": port,
        "uid": os.getuid(),
        "host": socket.gethostname(),
        "started": now_iso(),
        "cwd": os.getcwd(),
        "label": args.label or "",
        "verdi": verdi_home(),
        "display": os.environ.get("DISPLAY", ""),
        "cmd": cmd,
        "fsdb": _arg_values(args.verdi_args, "-ssf"),
        "design": _arg_values(args.verdi_args, "-f"),
        "status": "starting",
    }
    write_entry(entry)

    deadline = time.time() + args.timeout
    while time.time() < deadline:
        if proc.poll() is not None:
            (STATE_DIR / f"{RESERVE_PREFIX}{port}").unlink(missing_ok=True)
            entry_path(sid).unlink(missing_ok=True)
            sys.exit(f"error: verdi exited during startup (rc={proc.returncode})")
        if ss_listen(port):
            break
        time.sleep(0.5)
    else:
        proc.terminate()
        entry_path(sid).unlink(missing_ok=True)
        (STATE_DIR / f"{RESERVE_PREFIX}{port}").unlink(missing_ok=True)
        sys.exit(f"error: port {port} did not open within {args.timeout}s")

    (STATE_DIR / f"{RESERVE_PREFIX}{port}").unlink(missing_ok=True)
    entry["status"] = "up"
    write_entry(entry)

    print(f"session {sid}  port {port}  pid {proc.pid}  display {entry['display']}")
    if args.label:
        print(f"label   {args.label}")
    print(f"attach  verdi-session exec {sid} 'wvGetAllWindows'")

    if args.detach:
        if log:
            log.close()
        return 0

    def forward(sig, _frame):
        try:
            proc.send_signal(sig)
        except ProcessLookupError:
            pass

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)

    rc = proc.wait()
    entry_path(sid).unlink(missing_ok=True)
    return rc


def cmd_list(args):
    entries = read_entries()
    out = []
    for e in entries:
        st = session_state(e)
        if st == "stale" and not args.all:
            continue
        row = dict(e)
        row["state"] = st
        out.append(row)
    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    if not out:
        print("no sessions")
        return 0
    print(f"{'ID':<10} {'PORT':<6} {'PID':<8} {'STATE':<8} {'LABEL':<20} CWD")
    for e in out:
        print(f"{e.get('id','?'):<10} {str(e.get('port','?')):<6} "
              f"{str(e.get('pid','?')):<8} {e['state']:<8} "
              f"{e.get('label','')[:20]:<20} {Path(e.get('cwd','')).name}")
    return 0


def cmd_exec(args):
    e = resolve(args.id, args.label, args.port)
    st = session_state(e)
    if st != "up":
        if args.json:
            print(json.dumps({"type": "error", "code": "session_down",
                              "message": f"session {e['id']} is {st}, not usable"}))
        else:
            print(f"error: session {e['id']} is {st}, not usable", file=sys.stderr)
        return 3
    client = cmdclient_path()
    ensure_state()
    lock_path = STATE_DIR / f"{e['id']}.lock"
    lock = open(lock_path, "w")
    deadline = time.time() + max(0.0, args.lock_timeout)
    acquired = False
    try:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except BlockingIOError:
                if time.time() >= deadline:
                    break
                time.sleep(0.05)
        if not acquired:
            msg = f"session {e['id']} is busy"
            if args.json:
                print(json.dumps({"type": "error", "code": "busy", "message": msg}))
            else:
                print(f"error: {msg}", file=sys.stderr)
            return 75
        cmd = [client, str(e["port"])]
        if args.json:
            cmd.append("--json")
        if args.hold:
            cmd += ["--hold", str(args.hold)]
        cmd += args.command
        r = subprocess.run(cmd, env=build_env())
        return r.returncode
    finally:
        if acquired:
            fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def cmd_stop(args):
    e = resolve(args.id, args.label, args.port)
    pid = e.get("pid")
    if not pid or f"-serverPort {e.get('port')}" not in proc_cmdline(pid):
        entry_path(e["id"]).unlink(missing_ok=True)
        print(f"session {e['id']}: process gone, registry entry removed")
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(20):
        if not pid_alive(pid):
            break
        time.sleep(0.5)
    if pid_alive(pid):
        os.kill(pid, signal.SIGKILL)
    entry_path(e["id"]).unlink(missing_ok=True)
    print(f"session {e['id']} stopped")
    return 0


def cmd_prune(_args):
    removed = 0
    for e in read_entries():
        if session_state(e) == "stale":
            entry_path(e["id"]).unlink(missing_ok=True)
            removed += 1
    for p in STATE_DIR.glob(f"{RESERVE_PREFIX}*") if STATE_DIR.is_dir() else []:
        p.unlink(missing_ok=True)
    print(f"removed {removed} stale entr{'y' if removed == 1 else 'ies'}")
    return 0


def cmd_info(args):
    e = resolve(args.id)
    e = dict(e)
    e["state"] = session_state(e)
    print(json.dumps(e, indent=2))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="verdi-session")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("start")
    p.add_argument("--label", default="")
    p.add_argument("--port", type=int)
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    p.add_argument("--detach", action="store_true")
    p.add_argument("verdi_args", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("list")
    p.add_argument("--json", action="store_true")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("exec")
    p.add_argument("--id")
    p.add_argument("--label")
    p.add_argument("--port", type=int)
    p.add_argument("--hold", type=int, default=0)
    p.add_argument("--json", action="store_true")
    p.add_argument("--lock-timeout", type=float, default=5)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_exec)

    p = sub.add_parser("stop")
    p.add_argument("--id")
    p.add_argument("--label")
    p.add_argument("--port", type=int)
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("prune")
    p.set_defaults(func=cmd_prune)

    p = sub.add_parser("info")
    p.add_argument("--id")
    p.add_argument("--label")
    p.add_argument("--port", type=int)
    p.set_defaults(func=cmd_info)

    args = ap.parse_args()
    if args.cmd == "start" and args.verdi_args and args.verdi_args[0] == "--":
        args.verdi_args = args.verdi_args[1:]
    if args.cmd == "exec":
        if args.command and args.command[0] == "--":
            args.command = args.command[1:]
        if not args.command:
            ap.error("exec requires at least one Verdi command")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
