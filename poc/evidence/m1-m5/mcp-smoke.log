[2026-10-18T10:23:12.303Z] result verdi_source_get: {"ok":true,"data":{"file":"/home/faye/mydrv/aiwork/verdimcp/demo/rtl/sync_fifo.v","line":1,"snippet":"// Synchronous FIFO with valid/ready handshakes.\n// Demo DUT for Verdi MCP waveform tests.\n`timescale 1ns/1ps\n\nmodule sync_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter DEPTH      = 4,\n    parameter ADDR_WIDTH = 2\n) (\n    input  wire                  clk,\n    input  wire                  rst_n,\n\n    input  wire                  wr_valid,\n    output wire                  wr_ready,\n    input  wire [DATA_WIDTH-1:0] wr_data,\n\n    output wire                  rd_valid,\n    input  wire                  rd_ready,\n    output wire [DATA_WIDTH-1:0] rd_data,\n","source":"file"},"meta":{"tool":"verdi_source_get","elapsed_ms":48}}
