[2026-10-18T10:17:58.841Z] result verdi_source_get: {"ok":true,"data":{"file":"/home/faye/mydrv/aiwork/verdimcp/demo/tb/tb_sync_fifo.v","line":6,"snippet":"module tb_sync_fifo;\n\n    localparam DATA_WIDTH = 8;\n    localparam DEPTH      = 4;\n    localparam ADDR_WIDTH = 2;\n\n    reg                   clk;\n    reg                   rst_n;\n    reg                   wr_valid;\n    wire                  wr_ready;\n    reg  [DATA_WIDTH-1:0] wr_data;\n    wire                  rd_valid;\n    reg                   rd_ready;\n    wire [DATA_WIDTH-1:0] rd_data;\n    wire                  full;\n    wire                  empty;\n    wire [ADDR_WIDTH:0]   count;\n\n    integer               errors;\n    reg  [DATA_WIDTH-1:0] rd_capture;\n\n    sync_fifo #(\n        .DATA_WIDTH (DATA_WIDTH),\n        .DEPTH      (DEPTH),\n        .ADDR_WIDTH (ADDR_WIDTH)\n    ) dut (\n        .clk      (clk),\n        .rst_n    (rst_n),\n        .wr_valid (wr_valid),\n        .wr_ready (wr_ready),\n        .wr_data  (wr_data),\n        .rd_valid (rd_valid),\n        .rd_ready (rd_ready),\n        .rd_data  (rd_data),\n        .full     (full),\n        .empty    (empty),\n        .count    (count)\n    );\n\n    always #5 clk = ~clk;","source":"gui"},"meta"
